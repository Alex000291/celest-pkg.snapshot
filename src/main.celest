import "std:Test";
import "std:JSON";
import "std:Bytes";

export function match(name, actual) {
    if (Test.snapshot(name, actual) == 0) {
        throw "snapshot differs; run cpm test --snapshot-update to accept it";
    }
}

export function equal(actual, expected) {
    if (Test.byte_equal(actual, expected) == 0) {
        throw "snapshot bytes differ";
    }
}

export function json(name, value) {
    byte[8] encoded = JSON.stringify(value);
    match(name, Bytes.dynamic_bytes(encoded));
}

export function object(name, value) {
    json(name, value);
}

test "canonical snapshot protocol accepts explicit updates" {
    match("canonical-bytes", byte(01 02 03));
}
